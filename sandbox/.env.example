# Contract sandbox only — not used by Vite / frontend.
# Copy to sandbox/.env and fill deployer key.

# --- Local Avalanche 1337 ---
SANDBOX_RPC_URL=http://192.168.88.62:9650/ext/bc/C/rpc
SANDBOX_CHAIN_ID=1337
SANDBOX_NATIVE_TOKEN=AVAX

# --- Fuji 43113 (npm run sandbox:deploy:fuji) ---
# Alchemy Avalanche Fuji RPC — get key at https://dashboard.alchemy.com
ALCHEMY_API_KEY=
# Optional override (defaults to https://avax-fuji.g.alchemy.com/v2/${ALCHEMY_API_KEY})
# FUJI_RPC_URL=
# Public RPC fallback for verify: RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Production metadata for land NFTs on Fuji:
# SANDBOX_METADATA_BASE_URI=https://www.sarakt.com/metadata/land/{id}.json

# Deploy with sales OFF (default). Set true only for intentional open-at-deploy.
SALES_ACTIVE=false

# Gnosis Safe on Fuji (2-of-3) — required for npm run sandbox:transfer:safe
# SAFE_ADDRESS=0x...

# Transfer dry-run (no broadcast):
# DRY_RUN=1

# Canonical xBGL on ChaosStar (8888) — reference for deploy lineage (optional)
# CHAOSSTAR_RPC_URL=http://127.0.0.1:24362/ext/bc/ChaosStar/rpc
# CHAOSSTAR_XBGL_ADDRESS=0x...

# Skip xBGL deploy if already on chain
# XBGL_TOKEN_ADDRESS=0x...

# Plot = 100 EUR; 1 EUR = 1.955833 xBGL (auto-computed unless overridden)
# PHASE1_PRICE_XBGL_WEI=195583300000000000000
# PHASE1_PRICE_AVAX_WEI=...  # auto: 100*EUR_TO_USDC/AVAX_USD
# PLOT_PRICE_EUR=100
# EUR_TO_USDC_RATE=1.1
# AVAX_USD_PRICE=25

# Same key as Fuji deployer (derive: cast wallet address --private-key 0x...)
XBGL_DEPLOYER_PRIVATE_KEY=
FUJI_PRIVATE_KEY=

# ERC-1155 metadata template (must include {id}); served by Vite in dev
SANDBOX_METADATA_BASE_URI=http://localhost:8080/metadata/land/{id}.json

# Smoke (npm run sandbox:smoke:fuji)
# SANDBOX_SMOKE_PLOT_ID=42
# SANDBOX_SMOKE_DEPOSIT_AVAX=0.15
