# Contract sandbox only — not used by Vite / frontend.
# Copy to sandbox/.env and fill deployer key.

SANDBOX_RPC_URL=http://192.168.88.62:9650/ext/bc/C/rpc
SANDBOX_CHAIN_ID=1337
SANDBOX_NATIVE_TOKEN=AVAX

# Canonical xBGL on ChaosStar (8888) — reference for deploy lineage (optional)
# CHAOSSTAR_RPC_URL=http://127.0.0.1:24362/ext/bc/ChaosStar/rpc
# CHAOSSTAR_XBGL_ADDRESS=0x...

# Skip xBGL deploy if already on 1337
# XBGL_TOKEN_ADDRESS=0x...

# Plot = 100 EUR; 1 EUR = 1.955833 xBGL (auto-computed unless overridden)
# PHASE1_PRICE_XBGL_WEI=195583300000000000000
# PHASE1_PRICE_AVAX_WEI=...  # auto: 100*EUR_TO_USDC/AVAX_USD
# PLOT_PRICE_EUR=100
# EUR_TO_USDC_RATE=1.1
# AVAX_USD_PRICE=25

# Same key as Fuji deployer (derive: forge wallet address --private-key 0x...)
XBGL_DEPLOYER_PRIVATE_KEY=
FUJI_PRIVATE_KEY=

# ERC-1155 metadata template (must include {id}); served by Vite in dev
SANDBOX_METADATA_BASE_URI=http://localhost:8080/metadata/land/{id}.json
