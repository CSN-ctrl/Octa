# -----------------------------------------------------------------------------
# Octavia frontend — copy to `.env` or `.env.local` and adjust.
# Canonical Supabase ref: zfzsiykutsgkurmetprw (wired via src/config/connections.ts + Cursor MCP user-supabase).
# Dashboard: https://supabase.com/dashboard/project/zfzsiykutsgkurmetprw/settings/api
# -----------------------------------------------------------------------------

# Supabase (required for custom envs; defaults in src/config/connections.ts match MCP-linked project)
#
# URL + key must be the SAME project. If you set VITE_SUPABASE_URL to another ref (e.g. agqkiwarwxrcemhspxxv)
# but omit VITE_SUPABASE_ANON_KEY / VITE_SUPABASE_PUBLISHABLE_KEY for that project, the URL is ignored and
# the bundled default (zfzs...) is used—you will see a console warning.
#
VITE_SUPABASE_URL=https://zfzsiykutsgkurmetprw.supabase.co
# Optional: same project URL for Node/tsx scripts (create-accounts-admin.ts). Overrides VITE_SUPABASE_URL for Admin API.
# SUPABASE_URL=https://zfzsiykutsgkurmetprw.supabase.co
# Legacy anon JWT (public; safe in SPA). Regenerate from Dashboard if rotated.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpmenNpeWt1dHNna3VybWV0cHJ3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQxNzUzMDAsImV4cCI6MjA4OTc1MTMwMH0.Jc6md2XRZZvYGcvuXvg45YmTqot4dUGaopvKfZFV1mY
# Optional: publishable key from MCP get_publishable_keys (preferred over legacy anon when set)
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_5cTaFbCxBYCYWUa6Zw99sA_4FgQVU1t
#
# Password reset emails (Supabase Auth → Email templates → Reset password):
# Use {{ .ConfirmationURL }} in the template link. After the user clicks it, Supabase verifies the token
# then redirects to this app’s /reset-password (set by resetPasswordForEmail redirectTo in Login).
# In Dashboard: Authentication → URL configuration → add every origin you use, e.g.
#   https://www.yourdomain.com/reset-password
#   https://*.vercel.app/reset-password   (if previews apply)
# Site URL should be your production app origin; redirect URLs must include /reset-password for that host.

# Auth migration (scripts/migrate-auth-users.ts): service_role for OLD project in SUPABASE_SERVICE_ROLE_KEY;
# add target (zfzs) key here — never commit real values.
# MIGRATE_TARGET_SERVICE_ROLE_KEY=
# Optional: zfzs service_role for scripts when SUPABASE_SERVICE_ROLE_KEY is still the legacy project
# ZFZS_SERVICE_ROLE_KEY=

# ChaosStar Go backend (PDF certs, legacy REST). Default in src/env.ts: localhost:5001
VITE_API_URL=http://localhost:5001

# ChaosStar Network (optional)
VITE_CHAOSSTAR_RPC=http://127.0.0.1:24362/ext/bc/ChaosStar/rpc
VITE_STARGATE_RPC=http://localhost:8545
VITE_CHAIN_ID=8088
VITE_BLOCKCHAIN_ID=ZgQsbJYPaujPcQpF6k8Kfw1GRpnwoaAfVkf435C4R2MRBXLgy
VITE_NETWORK_NAME=ChaosStar Network
VITE_NATIVE_TOKEN=xBGL

# Legacy (optional)
VITE_AVALANCHE_RPC=http://127.0.0.1:24362/ext/bc/ChaosStar/rpc
VITE_CONTRACT_ADDRESS=native

# Alchemy (multi-chain tx history) — required for those features; no hardcoded fallback in code
VITE_ALCHEMY_API_KEY=

# Optional: legacy registry HTTP (see CONNECTIONS.md)
# VITE_REGISTRY_URL=http://localhost:8000

# Sentry (optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Analytics (optional)
