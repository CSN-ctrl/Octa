# -----------------------------------------------------------------------------
# Octavia frontend — copy to `.env` or `.env.local` and adjust.
# Canonical Supabase ref: zfzsiykutsgkurmetprw (wired via src/config/connections.ts + Cursor MCP user-supabase).
# Dashboard: https://supabase.com/dashboard/project/zfzsiykutsgkurmetprw/settings/api
# -----------------------------------------------------------------------------

# Supabase (required for custom envs; defaults in src/config/connections.ts match MCP-linked project)
#
# URL + key must be the SAME project. If you set VITE_SUPABASE_URL to another ref (e.g. agqkiwarwxrcemhspxxv)
# but omit VITE_SUPABASE_ANON_KEY / VITE_SUPABASE_PUBLISHABLE_KEY for that project, the URL is ignored and
# the bundled default (zfzs...) is used—you will see a console warning.
#
VITE_SUPABASE_URL=https://zfzsiykutsgkurmetprw.supabase.co
# Optional: same project URL for Node/tsx scripts (create-accounts-admin.ts). Overrides VITE_SUPABASE_URL for Admin API.
# SUPABASE_URL=https://zfzsiykutsgkurmetprw.supabase.co
# Legacy anon JWT (public; safe in SPA). Regenerate from Dashboard if rotated.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpmenNpeWt1dHNna3VybWV0cHJ3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQxNzUzMDAsImV4cCI6MjA4OTc1MTMwMH0.Jc6md2XRZZvYGcvuXvg45YmTqot4dUGaopvKfZFV1mY
# Optional: publishable key from MCP get_publishable_keys (preferred over legacy anon when set)
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_5cTaFbCxBYCYWUa6Zw99sA_4FgQVU1t
#
# Password reset emails (Supabase Auth → Email templates → Reset password):
# Use {{ .ConfirmationURL }} in the template link. After the user clicks it, Supabase verifies the token
# then redirects to this app’s /reset-password (redirectTo from getPasswordResetRedirectUrl() in src/lib/app-origin.ts).
# Production uses canonical https://www.sarakt.com/reset-password (non-localhost hosts); localhost still uses the dev origin.
# In Dashboard: Authentication → URL configuration → allow that URL, e.g.
#   https://www.sarakt.com/reset-password
#   https://*.vercel.app/reset-password   (only if you still send reset links to previews)
# Site URL should be your production app origin; redirect URLs must include /reset-password for hosts you use.
#
# Signup confirmation (Auth → Email templates → Confirm signup):
# Link must use {{ .ConfirmationURL }}. redirect is emailRedirectTo from getEmailConfirmationRedirectUrl() in src/lib/app-origin.ts
# → canonical https://www.sarakt.com/email-verified in production. Allow that URL under Authentication → URL configuration.
# Copy HTML from supabase/email-templates/ into the dashboard (see supabase/email-templates/EMAIL_TEMPLATES.txt).

# Auth migration (scripts/migrate-auth-users.ts): service_role for OLD project in SUPABASE_SERVICE_ROLE_KEY;
# add target (zfzs) key here — never commit real values.
# MIGRATE_TARGET_SERVICE_ROLE_KEY=
# Optional: zfzs service_role for scripts when SUPABASE_SERVICE_ROLE_KEY is still the legacy project
# ZFZS_SERVICE_ROLE_KEY=

# WalletConnect v2 (optional) — enables "WalletConnect" in Connect Wallet for mobile / any WalletConnect app.
# Create a project at https://cloud.walletconnect.com and paste the Project ID. Rebuild after setting.
# VITE_WALLETCONNECT_PROJECT_ID=

# ChaosStar Go backend (PDF certs, legacy REST). Default in src/env.ts: localhost:5001
VITE_API_URL=http://localhost:5001

# ChaosStar (8888) — app wallet / branding; optional canonical xBGL ERC-20 reference address
VITE_CHAOSSTAR_RPC=/chaosstar-rpc
# VITE_CHAOSSTAR_WALLET_RPC=http://127.0.0.1:24362/ext/bc/ChaosStar/rpc
VITE_CHAOSSTAR_CHAIN_ID=8888
# VITE_CHAOSSTAR_XBGL_ADDRESS=0x...   # from ChaosStar; used at deploy + docs (not the 1337 game token)

# Avalanche payment rail — local 1337 now; Fuji 43113 later (change only env + redeploy)
VITE_AVALANCHE_RPC=http://192.168.88.62:9650/ext/bc/C/rpc
# VITE_WALLET_RPC=http://192.168.88.62:9650/ext/bc/C/rpc
VITE_CHAIN_ID=1337
VITE_NETWORK_NAME=Avalanche Local C-Chain
# Fuji example (uncomment when switching):
# VITE_CHAIN_ID=43113
# VITE_NETWORK_NAME=Avalanche Fuji
# VITE_AVALANCHE_RPC=https://api.avax-test.network/ext/bc/C/rpc
VITE_NATIVE_TOKEN=AVAX

# Crypto on-chain (default true): balances, deposits (AVAX→xBGL via treasury contract), land — no Supabase ledger
VITE_ONCHAIN_CRYPTO=true

# Optional subnet / legacy (not required for AVAX C-Chain deploys)
# VITE_CHAOSSTAR_RPC=http://192.168.88.62:9654/ext/bc/Yy9YBphs5ThMEqo4eQZHW2TLXKqtXqVZY1yFzxf9tfWrFJxrJ/rpc
# VITE_BLOCKCHAIN_ID=ZgQsbJYPaujPcQpF6k8Kfw1GRpnwoaAfVkf435C4R2MRBXLgy

# Game contracts on 1337 (from npm run sandbox:deploy → 1337-latest.json)
VITE_CONTRACT_ADDRESS=
VITE_XBGL_TOKEN_ADDRESS=
VITE_TREASURY_ADDRESS=
VITE_DIGITAL_ID_ADDRESS=

# --- Contract sandbox (no VITE_* — use sandbox/.env + npm run sandbox:*) ---
# copy sandbox/.env.example → sandbox/.env
# addresses: sandbox/deployments/1337-latest.json

# Alchemy (multi-chain tx history) — required for those features; no hardcoded fallback in code
VITE_ALCHEMY_API_KEY=

# Optional: legacy registry HTTP (see CONNECTIONS.md)
# VITE_REGISTRY_URL=http://localhost:8000

# Sentry (optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Analytics (optional)
VITE_GA_MEASUREMENT_ID=

# Security / feature flags
# Keep disabled in production unless you explicitly need these behaviors.
VITE_ENABLE_PRIVATE_KEY_CUSTODY=false
VITE_ENABLE_TEST_ROUTES=false
